# Server
PORT=3000
NODE_ENV=production

# MySQL (valores por defecto para docker-compose local; override en producción)
DB_HOST=mysql
DB_PORT=3306
DB_USER=examen
DB_PASSWORD=examen_pass
DB_NAME=examen3

# Imagen externa (Lorem Picsum — no requiere API key)
EXTERNAL_IMAGE_BASE_URL=https://picsum.photos
EXTERNAL_IMAGE_WIDTH=600
EXTERNAL_IMAGE_HEIGHT=400

# CORS (en este proyecto el backend sirve el frontend estático, así que
# no se requiere CORS para uso normal. Si separas frontend, pon aquí su URL.)
CORS_ORIGIN=*
